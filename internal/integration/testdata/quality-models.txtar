# One offline bundled model; adoption is explicit, previewable, and local.
mkdir project
cd project
exec git init -q
status 0 dotspec list quality-model --json
stdout '^\{\n  "schema_version": 1,'
stdout '"entries": \[\]'
exec dotspec docs quality-models/iso-25010-2023
stdout '### Recoverability'
status 2 dotspec new quality-model iso-25010-2023
stderr 'reserved'
status 2 dotspec new quality-model Bad--Slug --from nope
stderr '^dotspec: invalid quality-model slug "Bad--Slug": '
mkdir specs
cp $WORK/new-system.md specs/new-system.system.spec.md
cp specs/new-system.system.spec.md before.md
status 0 dotspec new quality-attribute availability --from iso-25010-2023 --dry-run
cmp specs/new-system.system.spec.md before.md
stdout 'id: "reliability"'
stdout 'id: "availability"'
stdout 'quality/reliability/availability/availability.quality-attribute.spec.md'
! exists specs/quality
status 0 dotspec new quality-attribute availability --from iso-25010-2023
stdout 'Added 2 attributes'
cmp specs/new-system.system.spec.md before.md
status 2 dotspec new quality-attribute availability --from iso-25010-2023
stderr 'quality attribute availability already exists'
! stdout .
status 2 dotspec new quality-attribute unknown --from iso-25010-2023
stderr 'unknown attribute'
cmp specs/new-system.system.spec.md before.md

# Local models share parsing, checking and discovery. Selecting a leaf copies ancestors.
status 0 dotspec new quality-model organization-quality --from iso-25010-2023 --json
stdout 'organization-quality.quality-model.md'
grep '^id: organization-quality$' specs/quality-models/organization-quality.quality-model.md
grep 'Recoverability' specs/quality-models/organization-quality.quality-model.md
status 2 dotspec new quality-model organization-quality
stderr 'refusing to overwrite'
cp ../local.md specs/quality-models/organization-quality.quality-model.md
status 0 dotspec check specs/quality-models/organization-quality.quality-model.md --json
stdout '"errors": 0'
status 0 dotspec list quality-model --json
stdout '"slug": "organization-quality"'
stdout '"kind": "quality-model"'
status 0 dotspec new quality-attribute narrow --from organization-quality --dry-run
stdout 'id: "broad"'
stdout 'id: "narrow"'
! stdout 'id: "unselected"'
status 0 dotspec new quality-attribute narrow --from organization-quality --json
stdout '"added":'
cmp specs/new-system.system.spec.md before.md
status 0 dotspec check --json
stdout '"errors": 0'
status 0 dotspec sources --json
stdout 'organization-quality.quality-model.md'
status 0 dotspec snapshot export
stdout '"kind": "QualityModel"'
stdout '"governing_quality_model":'
cp stdout snapshot.json
status 0 dotspec snapshot validate snapshot.json --json
stdout '"valid": true'

cp ../draft.md specs/quality-models/organization-quality.quality-model.md
status 0 dotspec check specs/quality-models/organization-quality.quality-model.md --json
stdout 'quality-model.attributes'
cp ../invalid.md specs/quality-models/invalid.quality-model.md
status 1 dotspec check specs/quality-models/invalid.quality-model.md --json
stdout 'structure.duplicate-section'
status 1 dotspec snapshot export
cp stdout partial.json
status 0 dotspec snapshot validate partial.json --json
stdout '"valid": true'
status 2 dotspec new quality-model ../escape
status 2 dotspec check specs/quality-models/missing.quality-model.md --json
stdout '"complete": false'
# A term with two parents navigates through both without adding authored labels.
cd ..
mkdir shared-project
cd shared-project
exec git init -q
mkdir specs
cp $WORK/new-system.md specs/new-system.system.spec.md
cp ../shared.md shared.quality-model.md
status 0 dotspec new quality-attribute resilience --from ./shared.quality-model.md
stdout 'Added 3 attributes'
status 0 dotspec new requirement resilient-service
cp ../resilient-service.md specs/requirements/resilient-service.requirement.spec.md
status 0 dotspec check specs/requirements/resilient-service.requirement.spec.md --json
stdout '"errors": 0'
! stdout 'requirement.undefined-attribute'
status 0 dotspec list quality-attribute
stdout 'Reliable'
stdout 'Secure'
stdout 'Resilience'
status 0 dotspec snapshot export
stdout '"role": "subattribute_of"'
cp stdout snapshot.json
status 0 dotspec snapshot validate snapshot.json --json
stdout '"valid": true'
-- local.md --
---
type: quality-model
id: organization-quality
---
# Organization quality
## Description
Attributes we tailor for our products.
## Edition
Team edition 1
## Sources
[Model guidance](https://example.test/quality)
## Quality attributes
### Broad concern
**ID:** broad
Our general concern.
### Narrow concern
**ID:** narrow
**Sub-attribute of:** broad
Our specific concern.
### Unselected concern
**ID:** unselected
A concern to consider later.
-- draft.md --
---
type: quality-model
---
# Draft model
-- invalid.md --
---
type: quality-model
---
# Invalid
## Quality attributes
## Quality attributes

-- shared.md --
---
type: quality-model
id: shared
---
# Shared qualities
## Quality attributes
### Reliable
**ID:** reliable
Keeps working.
### Secure
**ID:** secure
Resists misuse.
### Resilience
**ID:** resilience
**Sub-attribute of:** reliable, secure
Recovers from disruption, including attacks.
### Safe
**ID:** safe
Avoids harm.
-- resilient-service.md --
---
type: requirement-spec
quality_attributes: [resilience]
---
# Resilient service
## Applies to
Loss of one service instance.
## Statement
At least one instance remains able to serve requests.
## Evidence
Stop one instance and send a request.
## Rationale
Continue useful service during disruption.
-- new-system.md --
---
type: system-spec
---

# New system

## Description

Describe what this system is in one short paragraph.

## Purpose

Describe why this system exists and whom it serves.

## Scope

Describe the system's boundary and what it includes.
