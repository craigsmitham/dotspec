# A business rule is independently authored and referenced by software specs.
mkdir project
cd project
exec git init -q
status 0 dotspec list business-rule --json
stdout '"entries": \[\]'
mkdir specs
cp $WORK/new-system.md specs/new-system.system.spec.md
status 0 dotspec new use-case purchase
cp ../purchase.md specs/use-cases/purchase.use-case.spec.md
status 0 dotspec new business-rule approval --json
stdout 'approval.business-rule.spec.md'
status 2 dotspec new business-rule approval
stderr 'refusing to overwrite'
cp ../approval.md specs/business-rules/approval.business-rule.spec.md
status 0 dotspec list business-rule --json
stdout '"kind": "business-rule"'
stdout 'Manager approval'
status 0 dotspec check specs/business-rules/approval.business-rule.spec.md --json
stdout '"errors": 0'
status 0 dotspec check --json
stdout '"errors": 0'
status 0 dotspec sources --json
stdout 'approval.business-rule.spec.md'
status 0 dotspec snapshot export
stdout '"kind": "BusinessRule"'
stdout '"related_specifications":'
stdout '"status": "resolved"'
cp stdout snapshot.json
status 0 dotspec snapshot validate snapshot.json --json
stdout '"valid": true'
cmp specs/business-rules/approval.business-rule.spec.md ../approval.md

# Missing content is advisory; duplicate structure is an error retained by export.
cp ../draft.md specs/business-rules/draft.business-rule.spec.md
status 0 dotspec check specs/business-rules/draft.business-rule.spec.md --json
stdout 'business-rule.statement'
cp ../invalid.md specs/business-rules/invalid.business-rule.spec.md
status 1 dotspec check specs/business-rules/invalid.business-rule.spec.md --json
stdout 'structure.duplicate-section'
status 1 dotspec snapshot export
stdout '"severity": "error"'
cp stdout partial.json
status 0 dotspec snapshot validate partial.json --json
stdout '"valid": true'
status 2 dotspec new business-rule ../escape
status 0 dotspec -C specs check business-rules/approval.business-rule.spec.md

-- approval.md --
---
type: business-rule-spec
id: approval
---
# Manager approval
## Statement
Purchases above $10,000 require approval from a department manager.
## Applies to
Purchases by any department.
## Rationale
Make expenditure accountable.
## Authority
Purchasing policy approved by the board.
## Exceptions
Emergency purchases follow a separately approved exception rule.
## Related specifications
[Submit a purchase](../use-cases/purchase.use-case.spec.md) describes a software interaction.
-- purchase.md --
---
type: use-case-spec
---
# Submit a purchase
## Goal
Submit a purchase for approval.
## Related specifications
[Manager approval](../business-rules/approval.business-rule.spec.md#approval) governs purchases.
The citation records context; it does not establish software compliance.
-- draft.md --
---
type: business-rule-spec
---
# Draft
-- invalid.md --
---
type: business-rule-spec
---
# Ambiguous rule
## Statement
First rule.
## Statement
Second rule.
-- new-system.md --
---
type: system-spec
---

# New system

## Description

Describe what this system is in one short paragraph.

## Purpose

Describe why this system exists and whom it serves.

## Scope

Describe the system's boundary and what it includes.
