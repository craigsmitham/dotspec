# Discover the handbook in a consumer directory, with no source checkout.
exec dotspec --help
stdout 'guide +Read the offline authoring handbook'
exec dotspec guide
stdout 'Where should a promise live'
stdout 'dotspec guide examples/todo/specs/jobs/resume.job.spec.md'
exec dotspec guide examples/todo/specs/requirements/restart.requirement.spec.md
stdout 'restart acceptance test'
exec dotspec guide --list
stdout 'Define a criterion and distinguish a measure'
stdout 'docs/handbook/requirements.md#define-or-reference-the-criterion-once'
stdout 'examples  Browse the files bundled'
status 2 dotspec guide --list quality
exec dotspec guide examples/todo/SPEC.md
stdout 'Read the system specification'
exec dotspec guide examples/todo/specification/personal-task-list.system.spec-report.md
stdout 'Personal task list'
stdout '\[All requirements\]\(<requirements\.md>\)'
exec dotspec guide examples/todo/specification/requirements.md
stdout 'Preserve tasks across restart'
exec dotspec guide job
stdout 'progress'
exec dotspec guide use-case
stdout 'Start with actors and goals'
exec dotspec guide authority
stdout 'Choose the authoritative specification'
exec dotspec guide examples/todo/specs/use-cases/resume-list.use-case.spec.md
stdout 'Keep recorded work available'
exec dotspec guide examples/todo/specs/requirements/restart.requirement.spec.md
stdout '## Refines'
exec dotspec guide conventions
stdout 'AGENTS.md'

# A real check leads to a focused explanation, then to the authored example.
exec dotspec requirement init feedback
stdout 'dotspec guide requirement'
exec dotspec requirement init --help
stdout 'dotspec guide requirement'
cp draft specs/requirements/feedback.requirement.spec.md
exec dotspec requirement check feedback --json
stdout '"rule": "requirement.measurement-basis"'
! stdout 'Authoring guide'
exec dotspec requirement check feedback
stdout 'Guide: dotspec guide requirement.measurement-basis'
exec dotspec guide requirement.measurement-basis
stdout '## Define or reference the criterion once'
stdout 'An unresolved bound belongs in Open questions'
! stdout '## Describe context of use explicitly'
stdout 'dotspec guide examples/todo/specs/requirements/restart.requirement.spec.md'
exec dotspec guide examples/todo/specs/requirements/restart.requirement.spec.md
stdout 'Zero discrepancies across the two views'
! stdout 'Read linked pages'
exec dotspec guide examples
stdout 'examples/todo/specs/requirements/restart.requirement.spec.md'
status 2 dotspec guide requirement.misspelled
stderr 'unknown guide topic'
status 2 dotspec guide ../draft
status 2 dotspec guide docs/../draft

-- draft --
---
type: requirement-spec
---
# Timely feedback

## Statement

Members receive feedback promptly.

## Criterion

### Measure

Elapsed time to visible feedback.
