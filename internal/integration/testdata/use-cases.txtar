# Use-case commands compose with existing commands and retain exit/channel rules.
mkdir project
cd project
exec git init -q
status 0 dotspec use-case list --json
stdout '"groups": \[\]'
! stderr .
status 0 dotspec use-case init --path . -- check-specifications
stdout 'Created specs/use-cases/check-specifications.use-case.spec.md'
! stderr .
status 0 dotspec use-case show check-specifications --json
stdout '"system": null'
stdout '"main_success_scenario":'
status 0 dotspec system init
status 0 dotspec use-case show check-specifications
stdout '# New use case'
stdout 'System: New system'
status 0 dotspec use-case list --json
stdout '"use_cases": \['
stdout '"slug": "check-specifications"'
status 0 dotspec use-case check check-specifications --json
stdout '"complete": true'
stdout '"discovery": "direct"'
stdout '"context_files_checked": 1'
! stderr .
status 2 dotspec use-case init check-specifications
stderr 'refusing to overwrite'
! stdout .
status 2 dotspec use-case init invalid --format mermaid
! stdout .
! exists specs/use-cases/invalid.use-case.spec.md
status 2 dotspec use-case show check-specifications --path specs/use-cases
stderr 'selects a project directory'
status 2 dotspec use-case check absent --json
stdout '"complete": false'
! stderr .

# A focused check ignores malformed siblings; a project scan reports all files.
cp ../draft.md specs/use-cases/draft.use-case.spec.md
cp ../broken.md specs/use-cases/broken.use-case.spec.md
status 0 dotspec use-case check draft
stdout 'advice \[use-case.goal\]'
stdout 'Scan complete.'
! stderr .
status 1 dotspec use-case check broken --json
stdout '"rule": "metadata.frontmatter"'
! stderr .
status 1 dotspec check --json
stdout '"files_checked": 4'
stdout '"errors": 1'
stdout '"complete": true'
! stderr .
status 1 dotspec use-case list
stderr 'metadata.frontmatter'
! stdout .
# Brief and expanded prompts share a format and never overwrite existing drafts.
# The create-specification use case's "More detailed use-case prompts" branch
# is illustrated here; these assertions define only the outcomes exercised.
cd ..
mkdir elaboration
cd elaboration
status 0 dotspec use-case init reserve
status 0 dotspec use-case show reserve --json
stdout '"trigger": ""'
status 0 dotspec use-case init detailed --template expanded
status 0 dotspec use-case show detailed --json
stdout '"minimum_guarantees": "State or link'
stdout '"supporting_actors": "Name external'
status 2 dotspec use-case init invalid --template unknown
! exists specs/use-cases/invalid.use-case.spec.md
status 2 dotspec use-case init reserve --template expanded
stderr 'refusing to overwrite'

# Overview retains the stated boundary and permits unresolved, linkable branches.
cp ../branch.md specs/use-cases/reserve.use-case.spec.md
status 0 dotspec use-case list --overview
stdout 'Customer'
stdout 'Rental business'
stdout 'User task'
status 0 dotspec use-case list --overview --json
stdout '"system_boundary": "Rental business"'
status 0 dotspec use-case check reserve --json
! stdout '"rule": "use-case.extensions"'
! stderr .
cp ../branch-link.md specs/use-cases/link.use-case.spec.md
status 0 dotspec use-case check link --json
! stdout '"rule": "reference.unresolved"'
cp ../broken-branch-link.md specs/use-cases/link.use-case.spec.md
status 1 dotspec use-case check link --json
stdout '"rule": "reference.unresolved"'
! stderr .
-- branch.md --
---
type: use-case
---
# Reserve equipment
## Primary actor
Customer
## System boundary
Rental business
## Goal level
User task
## Main success scenario
Customer requests equipment; the business confirms a reservation.
## Extensions
### Preferred equipment unavailable
Handling unresolved: investigate whether to offer a substitute.
-- branch-link.md --
---
type: use-case
---
# Arrange equipment for a job
## Related behavior
[Substitution question](reserve.use-case.spec.md#preferred-equipment-unavailable).
-- broken-branch-link.md --
---
type: use-case
---
# Arrange equipment for a job
## Related behavior
[Substitution question](reserve.use-case.spec.md#missing-branch).
-- draft.md --
---
type: use-case
---
# An unfinished interaction
-- broken.md --
This is not a specification.
