# Use-case commands compose with existing commands and retain exit/channel rules.
mkdir project
cd project
exec git init -q
status 0 dotspec list use-case --json
stdout '"entries": \[\]'
! stderr .
status 0 dotspec list use-case
stdout 'No use cases found'
! stderr .
status 0 dotspec new use-case -C . -- check-specifications
stdout 'Created specs/use-cases/check-specifications.use-case.spec.md'
! stderr .
status 0 dotspec list use-case --json
stdout '^\{\n  "schema_version": 1,'
stdout '"slug": "check-specifications"'
stdout '"system": null'
! stderr .
grep '## Main success scenario' specs/use-cases/check-specifications.use-case.spec.md
mkdir specs
cp $WORK/new-system.md specs/new-system.system.spec.md
status 0 dotspec list use-case
stdout 'System: New system'
stdout 'Check specifications  \(specs/use-cases/check-specifications.use-case.spec.md\)'
! stderr .
status 0 dotspec list use-case --json
stdout '"kind": "use-case"'
stdout '"slug": "check-specifications"'
status 0 dotspec check specs/use-cases/check-specifications.use-case.spec.md --json
stdout '"complete": true'
stdout '"types": \[\s+"use-case"\s+\]'
stdout '"discovery": "direct"'
stdout '"files_checked": 1,'
stdout '"context_files_checked": 1'
! stderr .
cp specs/use-cases/check-specifications.use-case.spec.md ../check-specifications-before.md
status 2 dotspec new use-case check-specifications
stderr 'refusing to overwrite'
! stdout .
cmp specs/use-cases/check-specifications.use-case.spec.md ../check-specifications-before.md
status 0 dotspec -C specs/use-cases check check-specifications.use-case.spec.md
status 2 dotspec check specs/use-cases/absent.use-case.spec.md --json
stdout '"complete": false'
! stderr .

# A focused check ignores malformed siblings; a project scan reports all files.
cp ../draft.md specs/use-cases/draft.use-case.spec.md
cp ../broken.md specs/use-cases/broken.use-case.spec.md
status 0 dotspec check specs/use-cases/draft.use-case.spec.md
stdout 'advice \[use-case.goal\]'
stdout '\(scan complete\)'
! stderr .
status 1 dotspec check specs/use-cases/broken.use-case.spec.md --json
stdout '"rule": "metadata.frontmatter"'
! stderr .
status 1 dotspec check --json
stdout '"files_checked": 4'
stdout '"errors": 1'
stdout '"complete": true'
! stderr .
status 1 dotspec list use-case
stderr 'metadata.frontmatter'
! stdout .
# Brief and expanded prompts share a format and never overwrite existing drafts.
# The create-specification use case's "More detailed use-case prompts" branch
# is illustrated here; the assertions check the command outcomes for these inputs.
cd ..
mkdir elaboration
cd elaboration
status 0 dotspec new use-case reserve
! grep '## Trigger' specs/use-cases/reserve.use-case.spec.md
status 0 dotspec new use-case detailed --template expanded --json
stdout '"schema_version": 1'
stdout '"path": "(/|[A-Za-z]:\\\\).*detailed\.use-case\.spec\.md"'
! stderr .
grep '## Trigger\n\nDescribe the action or time event' specs/use-cases/detailed.use-case.spec.md
grep '## Preconditions\n\nDescribe the state expected' specs/use-cases/detailed.use-case.spec.md
grep '## Minimal guarantees\n\nState or link' specs/use-cases/detailed.use-case.spec.md
grep '## Supporting actors\n\nName external' specs/use-cases/detailed.use-case.spec.md
status 2 dotspec new use-case invalid --template unknown
! exists specs/use-cases/invalid.use-case.spec.md
status 2 dotspec new use-case reserve --template expanded
stderr 'refusing to overwrite'

# A use case may leave branches unresolved or link them to other specifications.
cp ../branch.md specs/use-cases/reserve.use-case.spec.md
status 0 dotspec check specs/use-cases/reserve.use-case.spec.md --json
! stdout '"rule": "use-case.extensions"'
! stderr .
cp ../branch-link.md specs/use-cases/link.use-case.spec.md
status 0 dotspec check specs/use-cases/link.use-case.spec.md --json
! stdout '"rule": "reference.unresolved"'
cp ../broken-branch-link.md specs/use-cases/link.use-case.spec.md
status 1 dotspec check specs/use-cases/link.use-case.spec.md --json
stdout '"rule": "reference.unresolved"'
! stderr .
-- branch.md --
---
type: use-case-spec
---
# Reserve equipment
## Primary actor
Customer
## System boundary
Rental business
## Goal level
User task
## Main success scenario
Customer requests equipment; the business confirms a reservation.
## Extensions
### Preferred equipment unavailable
Handling unresolved: investigate whether to offer a substitute.
-- branch-link.md --
---
type: use-case-spec
---
# Arrange equipment for a job
## Related specifications
[Substitution question](reserve.use-case.spec.md#preferred-equipment-unavailable).
-- broken-branch-link.md --
---
type: use-case-spec
---
# Arrange equipment for a job
## Related specifications
[Substitution question](reserve.use-case.spec.md#missing-branch).
-- draft.md --
---
type: use-case-spec
---
# An unfinished interaction
-- broken.md --
This is not a specification.
-- new-system.md --
---
type: system-spec
---

# New system

## Description

Describe what this system is in one short paragraph.

## Purpose

Describe why this system exists and whom it serves.

## Scope

Describe the system's boundary and what it includes.
