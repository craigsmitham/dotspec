# Saved snapshots remain useful independently of their source working tree.
mkdir project
cd project
exec git init -q
mkdir specs
cp $WORK/new-system.md specs/new-system.system.spec.md
status 0 dotspec new requirement preservation
status 0 dotspec snapshot export
stdout '"kind": "Requirement"'
stdout '"spans":'
stdout '"markdown":'
! stderr .
cp stdout snapshot.json
status 0 dotspec snapshot export
cmp stdout snapshot.json
status 0 dotspec snapshot validate snapshot.json --json
stdout '"valid": true'
! stderr .
rm specs
status 0 dotspec snapshot validate snapshot.json
stdout 'Snapshot is valid'
! stderr .

# Source authoring errors remain in a structurally valid exported snapshot.
mkdir specs
cp $WORK/new-system.md specs/new-system.system.spec.md
mkdir specs/requirements
cp ../invalid.md specs/requirements/invalid.requirement.spec.md
status 1 dotspec snapshot export
stdout '"diagnostics":'
stdout '"severity": "error"'
! stderr .
cp stdout invalid-source.json
status 0 dotspec snapshot validate invalid-source.json --json
stdout '"valid": true'
! stderr .

# Invalid JSON or model shape is a finding; invocation and I/O failures use 2.
status 1 dotspec snapshot validate ../bad-json.json --json
stdout '"valid": false'
stdout 'shape.json'
! stderr .
status 1 dotspec snapshot validate ../bad-shape.json --json
stdout '"valid": false'
! stderr .
status 2 dotspec snapshot validate absent.json
! stdout .
status 2 dotspec snapshot export extra
! stdout .
status 0 dotspec snapshot schema
stdout '"Snapshot"'
! stderr .
-- invalid.md --
---
type: requirement-spec
unsupported_metadata: retained
---
# Invalid authored metadata
## Statement
Keep this text even though the metadata is invalid.
-- bad-json.json --
{"model_version":
-- bad-shape.json --
{}
-- new-system.md --
---
type: system-spec
---

# New system

## Description

Describe what this system is in one short paragraph.

## Purpose

Describe why this system exists and whom it serves.

## Scope

Describe the system's boundary and what it includes.
