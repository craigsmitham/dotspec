# Structural findings and unavailable files use distinct exit statuses.
exec git init -q
status 1 dotspec check --json
stdout '"rule": "identity.duplicate"'
stdout '"complete": true'
stdout '"files_checked": 2'
! stderr .
status 1 dotspec check specs/jobs/invalid.job.spec.md --json
stdout '"rule": "identity.duplicate"'
stdout '"files_checked": 1'
! stderr .
status 0 dotspec check specs/jobs/draft.job.spec.md --json
stdout '"severity": "advice"'
stdout '"complete": true'
! stderr .
status 2 dotspec check specs/jobs/absent.job.spec.md --json
stdout '"complete": false'
stdout '"rule": "scan.scope"'
! stderr .
status 2 dotspec check absent --json
stdout '"complete": false'
! stderr .
# A malformed selector is an invocation error. A malformed filename is a located finding.
status 2 dotspec new job Bad--Slug
! stdout .
stderr '^dotspec: invalid job slug "Bad--Slug": use lowercase letters or digits separated by single hyphens \(for example, develop-requirements\)$'
status 2 dotspec new feature Bad--Slug
! stdout .
stderr '^dotspec: invalid feature slug "Bad--Slug": use lowercase letters or digits separated by single hyphens \(for example, resume-work\)$'
cp specs/jobs/draft.job.spec.md specs/jobs/Bad--Slug.job.spec.md
status 1 dotspec check specs/jobs/Bad--Slug.job.spec.md
stdout 'Bad--Slug\.job\.spec\.md'
stdout 'error \[layout.job-name\]'
stdout 'invalid job slug "Bad--Slug": use lowercase letters or digits separated by single hyphens \(for example, develop-requirements\)'
! stderr .
-- specs/jobs/invalid.job.spec.md --
---
type: job-spec
id: repeated
---
# Invalid
## Steps
### Gather
**ID:** repeated
-- specs/jobs/draft.job.spec.md --
---
type: job-spec
---
# Draft
