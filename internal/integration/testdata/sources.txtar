# Ordinary links expose native specification sources without translating them.
mkdir project
cd project
exec git init -q
status 0 dotspec sources --json
stdout '"files": \[\]'
stdout '"complete": true'
! stderr .
mkdir specs
cp ../system.md specs/new-system.system.spec.md
status 0 dotspec new concept cli
status 0 dotspec new requirement preservation
cp ../concept.md specs/concepts/cli.concept.spec.md
cp ../quality.md specs/requirements/preservation.requirement.spec.md
cp ../native.tla native.tla
mkdir more-tests
cp ../native.tla more-tests/not-included.cfg
status 0 dotspec sources . --json
stdout 'native.tla'
stdout '"referenced_by": \['
stdout '"line":'
stdout '"declarations": \['
stdout '"defines": "concepts"'
stdout '"source": "../../native.tla#Example"'
stdout '"complete": true'
! stdout 'not-included'
! stdout 'catalog.unlisted'
! stderr .
cp stdout report.json
status 0 dotspec sources --json
cmp stdout report.json
cmp specs/concepts/cli.concept.spec.md ../concept.md
cmp specs/requirements/preservation.requirement.spec.md ../quality.md
cmp native.tla ../native.tla
status 0 dotspec sources
stdout 'Referenced by specs/concepts/cli.concept.spec.md'
stdout '^  Defines concepts: Native example · specs/concepts/cli.concept.spec.md:4:13 \(../../native.tla#Example\)$'
! stdout 'Referenced by specs/concepts/cli.concept.spec.md:4:13'
stdout 'Referenced by specs/requirements/preservation.requirement.spec.md'
! stdout 'Project|Outside any project'
stdout '^Listed 4 source files in \. \(scan complete\)\.$'
! stderr .

# Missing references are findings; an unavailable scope is an incomplete scan.
rm native.tla
status 1 dotspec sources --json
stdout 'reference.unresolved'
stdout '"complete": true'
! stderr .
status 2 dotspec sources absent --json
stdout '"complete": false'
! stderr .
status 2 dotspec sources absent
stdout '^Listed 0 source files in absent \(scan incomplete\)\.$'
! stdout 'No source files found'
! stderr .
status 1 dotspec sources specs --json
stdout '"complete": true'
! stderr .
status 2 dotspec sources one two
! stdout .
-- concept.md --
---
type: concept-spec
specifications:
  - source: ../../native.tla#Example
    defines: concepts
    name: Native example
---
# Native example
## Purpose
Find the executable specification.
## State
Referenced project sources.
## Actions
### Read definition
Read the native definition.
## Operational principles
Follow the link for required behavior.
[Native definition](../../native.tla)
[Directory](../../more-tests/)
-- quality.md --
---
type: requirement-spec
---
# Preserve source
## Applies to
Read commands.
## Statement
Source files remain unchanged.
## Evidence
Compare before and after bytes.
[Supporting material](../../native.tla)
## Rationale
Preserve authored work.
-- native.tla --
---- MODULE Example ----
\* Native syntax stays native; dotspec does not interpret this as Markdown.
\* [Not a specification link](absent.txt)
====
-- system.md --
---
type: system-spec
---

# New system

## Purpose

Describe why this system exists and whom it serves.

## Scope

Describe the system's boundary and what it includes.
