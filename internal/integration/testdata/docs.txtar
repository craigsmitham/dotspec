# A consumer starts outside a project and discovers the same topic in everyday terms.
exec dotspec --help
stdout 'docs +Browse the offline authoring handbook'
stdout 'dotspec docs job'
exec dotspec help
stdout 'dotspec docs job'
exec dotspec help job
stdout 'dotspec docs job'
exec dotspec docs
stdout 'What am I trying to specify'
stdout 'dotspec docs job'
exec dotspec docs job
stdout 'Jobs to be done'
stdout 'Write a job from a concrete situation \(How-to\)'
stdout 'What makes something a job to be done.*Explanation'
cp stdout topic
exec dotspec docs jtbd
cmp stdout topic
exec dotspec docs jobs to be done
cmp stdout topic
exec dotspec docs success criteria
stdout 'dotspec docs '
cp stdout search
exec dotspec docs 'success criteria'
cmp stdout search
exec dotspec __complete docs guides/write
stdout 'guides/write-a-job'
exec dotspec __complete docs jo
stdout '^job$'

# Creating a draft leads directly to the how-to, and its links work offline.
exec dotspec job init resume
stdout 'dotspec docs guides/write-a-job'
exec dotspec docs guides/write-a-job
stdout '## Where does the job end'
stdout 'dotspec docs guides/write-a-job#record-steps-and-shared-outcomes'
exec dotspec docs 'guides/write-a-job#record-steps-and-shared-outcomes'
stdout '^## Record steps and shared outcomes'
stdout '#### Applies to'
! stdout '^## Check the draft'
exec dotspec docs job
stdout 'examples/todo/specs/jobs/personal-commitments.job.spec.md'
exec dotspec docs examples/todo/specs/jobs/personal-commitments.job.spec.md
stdout '^type: job-spec'
stdout '## Evidence'
! stdout 'Read linked pages'
cp stdout saved
exec dotspec docs examples/todo/specs/jobs/personal-commitments.job.spec.md
cmp stdout saved

# A finding keeps its stable ID and the plain text guidance leads to the section.
exec dotspec requirement init feedback
stdout 'dotspec docs guides/write-an-assessable-requirement'
cp draft specs/requirements/feedback.requirement.spec.md
exec dotspec requirement check feedback --json
stdout '"rule": "requirement.measurement-basis"'
! stdout 'dotspec docs'
exec dotspec requirement check feedback
stdout 'Guide: dotspec docs requirement.measurement-basis'
exec dotspec docs requirement.measurement-basis
stdout '^## State how to judge a result'
exec dotspec docs job.performer
stdout '^## Who owns the result'
! stdout '^## Where does the job end'

status 2 dotspec docs job.misspelled
stderr 'job.misspelled.*run dotspec docs'
! stdout .
status 2 dotspec docs 'guides/write-a-job#typo'
stderr 'typo.*run dotspec docs'
status 2 dotspec docs guides/missing
stderr 'guides/missing.*run dotspec docs'
status 2 dotspec docs ../draft
stderr 'run dotspec docs'
status 2 dotspec docs xyzzy-missing
stderr 'no documentation matches.*run dotspec docs'

# Public reading is bounded by the installed handbook.
exec dotspec docs README
stdout 'The dotspec handbook'
exec dotspec __complete docs maintainers/
! stdout 'maintainers/'
status 2 dotspec docs maintainers/releasing
stderr 'run dotspec docs'
status 2 dotspec docs CONTRIBUTING.md
status 2 dotspec docs 'Snapshot builds never publish'

# Bundled reading needs no project. A consumer inspects files in their own project.
mkdir reader
cd reader
exec dotspec docs 'examples/todo/specs/jobs/personal-commitments.job.spec.md#job'
stdout '^## Job$'
! stdout '^## Performer'
exec dotspec docs guides/map-needs-to-capabilities
stdout '`dotspec model needs` from your project root'
stdout '`dotspec model needs --project todo` from the dotspec repository root'
status 2 dotspec model needs --project todo
stderr 'unknown project "todo"'
cp ../manifest dotspec.yaml
exec dotspec job init local-errands
exec dotspec job show local-errands
stdout 'local-errands.job.spec.md'
exec dotspec model needs
stdout 'Needs and specification map'
cd ..

-- manifest --
name: reader

-- draft --
---
type: requirement-spec
---
# Timely feedback

## Statement

Members receive feedback promptly.

## Criterion

### Measure

Elapsed time to visible feedback.
