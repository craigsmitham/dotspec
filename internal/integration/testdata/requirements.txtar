# Requirements share one inventory; quality attributes classify them.
mkdir project
cd project
exec git init -q
status 0 dotspec list requirement --json
stdout '"entries": \[\]'
status 0 dotspec new requirement work --json
stdout '"path":'
! stderr .
grep '## Statement' specs/requirements/work.requirement.spec.md
cp ../system.md specs/new-system.system.spec.md
mkdir specs/quality/reliability
cp ../system0.md specs/quality/reliability/reliability.quality-attribute.spec.md
mkdir specs/quality/reliability/preservation
cp ../system1.md specs/quality/reliability/preservation/preservation.quality-attribute.spec.md
cp ../rule.md specs/requirements/work.requirement.spec.md
cp ../repeatable.md specs/requirements/repeatable.requirement.spec.md
status 0 dotspec list requirement --json
stdout '"name": "Preserve source"'
stdout '"name": "Repeatable inspection"'
status 0 dotspec list quality-attribute
stdout 'System: New system'
stdout 'Preservation  \(specs/quality/reliability/preservation/preservation.quality-attribute.spec.md\)'

# Explicit links add bounded context. Checks do not change source files.
status 0 dotspec check specs/requirements/work.requirement.spec.md --json
stdout '"context_files_checked": 4'
stdout '"errors": 0'
! stderr .
cmp specs/requirements/work.requirement.spec.md ../rule.md
cmp specs/requirements/repeatable.requirement.spec.md ../repeatable.md
status 2 dotspec new requirement work
! stdout .
stderr 'refusing to overwrite'
cmp specs/requirements/work.requirement.spec.md ../rule.md
status 2 dotspec new requirement other --attribute ''
! stdout .
status 2 dotspec new requirement other --attribute unknown
stderr 'unknown quality attribute "unknown"'
! exists specs/requirements/other.requirement.spec.md
status 0 dotspec new requirement other --attribute preservation
grep 'quality_attributes: \["preservation"\]' specs/requirements/other.requirement.spec.md
status 0 dotspec -C specs/requirements check work.requirement.spec.md
status 2 dotspec check specs/requirements/missing.requirement.spec.md --json
stdout '"complete": false'
! stderr .

# Draft omissions are advice and preserve successful status.
cp ../draft.md specs/requirements/draft.requirement.spec.md
status 0 dotspec check specs/requirements/draft.requirement.spec.md --json
stdout 'requirement.statement'
stdout '"advice": 3'
stdout '"complete": true'
! stderr .

# Malformed files do not prevent findings in the rest of the scan.
cp ../broken.md specs/requirements/broken.requirement.spec.md
cp ../duplicate.md specs/requirements/duplicate.requirement.spec.md
status 1 dotspec check --json
stdout 'metadata.frontmatter'
stdout 'structure.duplicate-section'
stdout 'requirement.statement'
stdout '"complete": true'
! stderr .

# A broken cross-file target is a structural finding, not a scan failure.
cp ../bad-link.md specs/requirements/work.requirement.spec.md
status 1 dotspec check specs/requirements/work.requirement.spec.md --json
stdout 'reference.unresolved'
stdout '"complete": true'
! stderr .
-- system.md --
---
type: system-spec
---
# New system
## Purpose
Help reviewers.
## Scope
CLI.
## Goals
### Earlier review
Inspect drafts before review.
## Environment
Markdown files.
## Assumptions
### Stable sources
Sources are stable during comparisons.
## Constraints
Ordinary files.
## Glossary
### Scan
An inspection of selected source files.
-- rule.md --
---
type: requirement-spec
id: preserve
quality_attributes: [preservation]
---
# Preserve source
## Applies to
Inspection of source files.
## Statement
Inspection must leave source bytes unchanged.
## Rationale
Preserve authored work.
## Related specifications
[Repeatable inspection](repeatable.requirement.spec.md#statement)
[Term](../new-system.system.spec.md#scan)
-- repeatable.md --
---
type: requirement-spec
quality_attributes: [preservation]
---
# Repeatable inspection
## Applies to
Unchanged sources and environment.
## Statement
Repeated inspections yield equivalent findings.
## Rationale
Support meaningful comparisons.
-- draft.md --
---
type: requirement-spec
---
# Draft
-- broken.md --
Broken document.
