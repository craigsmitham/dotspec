# Adoption names its model. The bundled model is read offline through the handbook.
mkdir project
cd project
exec git init -q
cp ../default.yaml dotspec.yaml
status 0 dotspec snapshot export
cp stdout ../snapshot.json
status 0 dotspec docs quality-models/iso-25010-2023
stdout '^# ISO/IEC 25010:2023'
stdout '\*\*ID:\*\* recoverability'
status 0 dotspec docs iso 25010
stdout 'dotspec docs quality-models/iso-25010-2023'
! exists specs
cmp dotspec.yaml ../default.yaml

# Adoption targets the nearest enclosing system; the project root has none.
mkdir alpha/specs beta/specs
cp $WORK/new-system.md alpha/specs/new-system.system.spec.md
cp $WORK/new-system.md beta/specs/new-system.system.spec.md
status 2 dotspec new quality-attribute recoverability --from iso-25010-2023
stderr 'no system spec found'
! exists alpha/specs/quality
! exists beta/specs/quality
status 2 dotspec -C beta new quality-attribute recoverabilty --from iso-25010-2023
stderr 'dotspec docs quality-models/iso-25010-2023'
! exists beta/specs/quality
status 2 dotspec -C beta new quality-attribute recoverability --from=
stderr '--from requires a model ID or path'
status 2 dotspec -C beta new quality-attribute recoverability --from unknown-model
stderr 'unknown-model.quality-model.md: quality-model does not exist'
! exists beta/specs/quality
cp ../ignored .gitignore
status 2 dotspec -C alpha new quality-attribute recoverability --from iso-25010-2023
stderr 'ignored by Git'
! exists alpha/specs/quality
rm .gitignore
status 0 dotspec -C alpha new quality-attribute recoverability --from iso-25010-2023 --dry-run --json
stdout '^\{\n  "schema_version": 1,'
stdout '"decision": "create"'
! exists alpha/specs/quality
mkdir alpha/component
status 0 dotspec -C alpha/component new component Intake --part-of ../specs/new-system.system.spec.md
cd alpha/component
status 0 dotspec new quality-attribute recoverability --from iso-25010-2023
stdout 'Added 2 attributes'
status 0 dotspec new quality-attribute fault-tolerance --from iso-25010-2023
stdout 'Reused parent reliability'
stdout 'Added 1 attribute to'
status 2 dotspec new quality-attribute recoverability --from iso-25010-2023 --json
stderr 'quality attribute recoverability already exists'
! stdout .
cd ../..
exists alpha/specs/quality/reliability/recoverability/recoverability.quality-attribute.spec.md
! exists beta/specs/quality

# A local model is selected by path or slug. A term with two parents copies both.
cp ../shared.md shared.quality-model.md
status 0 dotspec -C beta new quality-attribute resilience --from ../shared.quality-model.md --dry-run
stdout 'Would create reliable'
stdout 'Would create secure'
stdout 'subattribute_of:\n  - "reliable"\n  - "secure"'
! exists beta/specs/quality
mkdir beta/specs/quality-models
cp ../shared.md beta/specs/quality-models/shared.quality-model.md
cd beta
status 0 dotspec new quality-attribute resilience --from shared
stdout 'Added 3 attributes'
! exists specs/quality/safe
cd ..
status 0 dotspec list quality-model
stdout 'Shared qualities  \(beta/specs/quality-models/shared.quality-model.md\)'
! stdout 'iso-25010'
status 0 dotspec list quality-model --json

# A malformed local model blocks adoption and writes nothing.
cp ../broken.md broken.quality-model.md
status 1 dotspec -C alpha new quality-attribute child --from ../broken.quality-model.md
stderr 'broken.quality-model.md'
! exists alpha/specs/quality/child
status 1 dotspec check --json
stdout 'broken.quality-model.md'
rm broken.quality-model.md

# The manifest has no quality setting, and a valid saved snapshot stays valid.
cp ../unknown-key.yaml dotspec.yaml
status 2 dotspec check
stderr 'line 3: unknown key "quality"; dotspec.yaml accepts name, specification_patterns, build.enabled and build.agent_instruction_files'
cp ../default.yaml dotspec.yaml
status 0 dotspec snapshot validate ../snapshot.json --json
stdout '"valid": true'
-- ignored --
**/recoverability/
-- default.yaml --
name: product
build: {enabled: false}
-- unknown-key.yaml --
name: product
build: {enabled: false}
quality: {model: iso-25010-2023}
-- shared.md --
---
type: quality-model
id: shared
---
# Shared qualities
## Quality attributes
### Reliable
**ID:** reliable
Keeps working.
### Secure
**ID:** secure
Resists misuse.
### Resilience
**ID:** resilience
**Sub-attribute of:** reliable, secure
Recovers from disruption, including attacks.
### Safe
**ID:** safe
Avoids harm.
-- broken.md --
---
type: quality-model
---
# Broken
## Quality attributes
### Broken child
**ID:** child
**Sub-attribute of:** missing
-- new-system.md --
---
type: system-spec
---

# New system

## Description

Describe what this system is in one short paragraph.

## Purpose

Describe why this system exists and whom it serves.

## Scope

Describe the system's boundary and what it includes.
