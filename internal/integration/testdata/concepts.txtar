# Concept commands compose with existing commands and retain exit/channel rules.
mkdir project
cd project
exec git init -q
status 0 dotspec list concept --json
stdout '"entries": \[\]'
! stderr .
status 0 dotspec list concept
stdout 'No concepts found'
! stderr .
status 0 dotspec new concept -C . -- job-map
stdout 'Created specs/concepts/job-map.concept.spec.md'
! stderr .
status 0 dotspec list concept --json
stdout '^\{\n  "schema_version": 1,'
stdout '"slug": "job-map"'
stdout '"system": null'
! stderr .
mkdir specs
cp $WORK/new-system.md specs/new-system.system.spec.md
status 0 dotspec list concept
stdout 'System: New system'
stdout 'Job map  \(specs/concepts/job-map.concept.spec.md\)'
! stderr .
status 0 dotspec list concept --json
stdout '"kind": "concept"'
stdout '"slug": "job-map"'
status 0 dotspec check specs/concepts/job-map.concept.spec.md --json
stdout '"complete": true'
stdout '"types": \[\s+"concept"\s+\]'
stdout '"discovery": "direct"'
stdout '"files_checked": 1,'
stdout '"context_files_checked": 1'
! stderr .
cp specs/concepts/job-map.concept.spec.md ../job-map-before.md
status 2 dotspec new concept job-map
stderr 'refusing to overwrite'
! stdout .
cmp specs/concepts/job-map.concept.spec.md ../job-map-before.md
status 0 dotspec -C specs/concepts check job-map.concept.spec.md
status 2 dotspec check specs/concepts/absent.concept.spec.md --json
stdout '"complete": false'
! stderr .

# A focused check ignores malformed siblings; a project scan reports all files.
cp ../draft.md specs/concepts/draft.concept.spec.md
cp ../broken.md specs/concepts/broken.concept.spec.md
status 0 dotspec check specs/concepts/draft.concept.spec.md
stdout 'advice \[concept.purpose\]'
stdout '\(scan complete\)'
! stderr .
status 1 dotspec check specs/concepts/broken.concept.spec.md --json
stdout '"rule": "metadata.frontmatter"'
! stderr .
status 1 dotspec check --json
stdout '"files_checked": 4'
stdout '"errors": 1'
stdout '"complete": true'
! stderr .
status 1 dotspec list concept
stderr 'metadata.frontmatter'
! stdout .

# JSON creation reports the absolute path of the new specification.
cd ..
mkdir created
cd created
status 0 dotspec new concept review --json
stdout '"schema_version": 1'
stdout '"path": "(/|[A-Za-z]:\\\\).*review\.concept\.spec\.md"'
! stderr .
-- draft.md --
---
type: concept-spec
---
# An unfinished concept
-- broken.md --
This is not a specification.
-- new-system.md --
---
type: system-spec
---

# New system

## Description

Describe what this system is in one short paragraph.

## Purpose

Describe why this system exists and whom it serves.

## Scope

Describe the system's boundary and what it includes.
